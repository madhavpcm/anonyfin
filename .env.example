# User and Group ID for container permissions
USER_ID=1000
GROUP_ID=1000

# Container timezone (e.g., America/New_York)
TIMEZONE=America/New_York

# Absolute path to your media root directory
MEDIA_ROOT=/path/to/your/media

# Local network subnet (e.g., 192.168.0.0/16)
LOCAL_NETWORK=192.168.0.0/16

# WireGuard VPN details (from PIA dashboard)
WG_ENDPOINT_IP=
WG_ENDPOINT_PORT=
WG_ADDRESS=
WG_PRIVATE_KEY=
WG_PUBLIC_KEY=

# PIA credentials (if using PIA for port forwarding with WireGuard)
PIA_USER=
PIA_PASS=
PIA_LOCATION=

# DNS server address (e.g., 1.1.1.1)
DNS=
